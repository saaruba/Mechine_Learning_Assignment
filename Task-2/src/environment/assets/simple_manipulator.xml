<!-- Task-2/src/environment/assets/simple_manipulator.xml -->
<mujoco model="simple_manipulator_planar">
  <compiler angle="degree" inertiafromgeom="true"/>
  <option timestep="0.002" gravity="0 0 0"/>

  <default>
    <joint limited="true" damping="6.0" armature="0.05" frictionloss="0.3"/>
    <geom density="900" friction="0.8 0.05 0.01" condim="3"/>
    <motor ctrllimited="true" ctrlrange="-1 1"/>
  </default>

  <worldbody>
    <light name="sun" pos="0 0 2.5" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>
    <light name="fill" pos="1.6 -1.0 1.2" dir="-1 1 -0.4" diffuse="0.4 0.4 0.4"/>
    <camera name="overview" pos="1.3 -1.3 1.1" euler="55 0 45"/>

    <geom name="floor" type="plane" pos="0 0 0" size="2 2 0.1" rgba="0.86 0.9 0.86 1"/>
    <geom name="table" type="box" pos="0 0 0.08" size="0.8 0.8 0.08" rgba="0.78 0.75 0.70 1"/>

    <body name="base_platform" pos="0 0 0.16">
      <geom name="base_geom" type="cylinder" size="0.12 0.04" rgba="0.22 0.25 0.30 1"/>
      <geom name="base_joint_vis" type="sphere" pos="0 0 0.04" size="0.03" rgba="0.95 0.85 0.2 1"/>

      <body name="yaw_body" pos="0 0 0.04">
        <joint name="base_yaw" type="hinge" axis="0 0 1" range="-180 180"/>
        <geom name="shoulder_joint_vis" type="sphere" size="0.028" rgba="0.95 0.95 0.3 1"/>

        <body name="link1_body" pos="0 0 0">
          <joint name="shoulder" type="hinge" axis="0 0 1" range="-170 170"/>
          <geom name="link1_geom" type="capsule" fromto="0.03 0 0 0.35 0 0" size="0.02" rgba="0.25 0.55 0.9 1"/>

          <body name="elbow_body" pos="0.35 0 0">
            <joint name="elbow" type="hinge" axis="0 0 1" range="-170 170"/>
            <geom name="elbow_joint_vis" type="sphere" size="0.026" rgba="0.3 0.95 0.95 1"/>
            <geom name="link2_geom" type="capsule" fromto="0.03 0 0 0.30 0 0" size="0.018" rgba="0.2 0.75 0.4 1"/>

            <body name="ee" pos="0.30 0 0">
              <geom name="ee_geom" type="sphere" size="0.024" rgba="0.15 0.95 0.2 1"/>
            </body>
          </body>
        </body>
      </body>
    </body>

    <body name="ball" pos="0.35 0.00 0.20">
      <geom name="ball_geom" type="sphere" size="0.03" rgba="1 0.1 0.1 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="motor_base_yaw" joint="base_yaw" gear="5"/>
    <motor name="motor_shoulder" joint="shoulder" gear="5"/>
    <motor name="motor_elbow" joint="elbow" gear="4"/>
  </actuator>
</mujoco>
