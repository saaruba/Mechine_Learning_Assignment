<mujoco model="simple_manipulator">
  <compiler angle="degree" inertiafromgeom="true"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <default>
    <joint damping="6.0" armature="0.05" frictionloss="0.2" limited="true"/>
    <geom density="900" friction="0.9 0.05 0.01" condim="3"/>
    <motor ctrllimited="true" ctrlrange="-1 1"/>
  </default>

  <worldbody>
    <light name="sun" pos="0 0 2.2" dir="0 0 -1" diffuse="0.9 0.9 0.9"/>
    <light name="fill" pos="1.5 -1.5 1.2" dir="-1 1 -0.5" diffuse="0.5 0.5 0.5"/>
    <camera name="overview" pos="1.2 -1.2 0.9" euler="45 0 45"/>

    <geom name="floor" type="plane" pos="0 0 0" size="2 2 0.1" rgba="0.85 0.9 0.85 1"/>

    <body name="base_platform" pos="0 0 0.05">
      <geom name="base_geom" type="cylinder" size="0.15 0.05" rgba="0.2 0.25 0.3 1"/>
      <geom name="base_joint_vis" type="sphere" pos="0 0 0.06" size="0.034" rgba="0.95 0.85 0.2 1"/>

      <body name="yaw_body" pos="0 0 0.06">
        <joint name="base_yaw" type="hinge" axis="0 0 1" range="-180 180"/>
        <geom name="shoulder_joint_vis" type="sphere" size="0.032" rgba="0.95 0.95 0.3 1"/>

        <body name="link1_body" pos="0 0 0">
          <joint name="shoulder" type="hinge" axis="0 1 0" range="0 180"/>
          <geom name="link1_geom" type="capsule" fromto="0 0 0 0.35 0 0" size="0.024" rgba="0.25 0.55 0.9 1"/>

          <body name="elbow_body" pos="0.35 0 0">
            <joint name="elbow" type="hinge" axis="0 1 0" range="0 180"/>
            <geom name="elbow_joint_vis" type="sphere" size="0.030" rgba="0.3 0.95 0.95 1"/>
            <geom name="link2_geom" type="capsule" fromto="0 0 0 0.30 0 0" size="0.022" rgba="0.2 0.7 0.4 1"/>

            <body name="ee" pos="0.30 0 0">
              <geom name="ee_geom" type="sphere" size="0.028" rgba="0.15 0.95 0.2 1"/>
            </body>
          </body>
        </body>
      </body>
    </body>

    <body name="ball" pos="0.35 0.0 0.08">
      <geom name="ball_geom" type="sphere" size="0.035" rgba="1 0.1 0.1 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="motor_base_yaw" joint="base_yaw" gear="5"/>
    <motor name="motor_shoulder" joint="shoulder" gear="5"/>
    <motor name="motor_elbow" joint="elbow" gear="4"/>
  </actuator>
</mujoco>
