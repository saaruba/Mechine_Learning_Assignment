<mujoco model="simple_manipulator">
    <compiler angle="degree" coordinate="local"/>
    <option gravity="0 0 -9.81"/>

    <worldbody>
        <!-- Ground -->
        <geom name="floor" type="plane" size="2 2 0.1" rgba="0.8 0.8 0.8 1"/>

        <!-- Base -->
        <body name="base" pos="0 0 0">
            <geom type="cylinder" size="0.05 0.02" rgba="1 0 0 1"/>

            <!-- Link 1 -->
            <body name="link1" pos="0 0 0.05">
                <joint name="joint1" type="hinge" axis="0 0 1"/>
                <geom type="capsule" fromto="0 0 0 0.3 0 0" size="0.03" rgba="0 1 0 1"/>

                <!-- Link 2 -->
                <body name="link2" pos="0.3 0 0">
                    <joint name="joint2" type="hinge" axis="0 0 1"/>
                    <geom type="capsule" fromto="0 0 0 0.25 0 0" size="0.025" rgba="0 0 1 1"/>

                    <!-- End effector -->
                    <body name="ee" pos="0.25 0 0">
                        <geom type="sphere" size="0.04" rgba="1 1 0 1"/>
                    </body>
                </body>
            </body>
        </body>

        <!-- Ball -->
        <body name="ball" pos="0.5 0.2 0.05">
            <geom type="sphere" size="0.04" rgba="1 0 0 1"/>
        </body>

    </worldbody>

    <actuator>
        <motor joint="joint1" ctrlrange="-1 1"/>
        <motor joint="joint2" ctrlrange="-1 1"/>
    </actuator>
</mujoco>